# =====================================================
# Project Management Environment Configuration
# =====================================================
#
# For FULL setup instructions (Docker local mode, cloud mode, etc.),
# see .env.local.template — that file is the comprehensive reference.
#
# Quick start: cp .env.local.template .env.local
# Or run: ./scripts/first-time-setup.sh

# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3100
LOG_LEVEL=debug
NODE_ENV=development

# Rate Limiting (optional - requires Upstash Redis)
#UPSTASH_REDIS_REST_URL=your_upstash_redis_url
#UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
#ENABLE_RATE_LIMIT=true

# Demo Mode (optional). Keep this OFF in production: demo mode shows the
# test accounts and their shared password on the login page.
#NEXT_PUBLIC_DEMO_MODE=true

# Public site URL used in sitemap.xml (falls back to NEXT_PUBLIC_APP_URL)
#NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Support contact on the welcome page (the card is hidden when none are set)
#NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
#NEXT_PUBLIC_SUPPORT_PHONE=+00 0000 000000
#NEXT_PUBLIC_SUPPORT_ADDRESS=Your office address

# Next.js anonymous telemetry is always disabled by scripts/dev-wrapper.js.
# If you ever run `next` directly (not via npm scripts), keep this set:
NEXT_TELEMETRY_DISABLED=1

# Playwright "production" tests target your own deployment
#PRODUCTION_URL=https://your-domain.com
